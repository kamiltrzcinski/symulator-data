#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent

# 1. Check CHANGELOG.md is staged and has version header
res_cl = subprocess.run(
    [sys.executable, str(root / "scripts" / "check-changelog.py")],
    cwd=str(root),
)
if res_cl.returncode != 0:
    sys.exit(res_cl.returncode)

# 2. Validate UID registry & JSON schemas
res_val = subprocess.run(
    [sys.executable, str(root / "scripts" / "precommit_validate.py")],
    cwd=str(root),
)
sys.exit(res_val.returncode)
